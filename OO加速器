            "账号Token": f"{OOTOKEN[:10]}...",
            "状态码": duration_res.status_code,
            "响应消息": duration_result.get('msg', '未知'),
            "响应码": duration_result.get('code', '无')
        })
        # 显示观看成功消息
        log.success("观看成功")
