# 随机延时（模拟人工操作节奏，规避风控）
def random_sleep(min_sec=1, max_sec=3):
    sleep_time = random.uniform(min_sec, max_sec)
    time.sleep(sleep_time)

# ========== 签到功能 ==========
def auto_checkin():
    if not OOTOKEN:
        log.error("未配置OOTOKEN环境变量！")
        return

    log.title("开始执行签到任务")
    headers = get_mobile_headers()
    data = {"access_token": OOTOKEN}

    try:
        log.step("请求前随机延时...")
        random_sleep()  # 请求前随机延时
        log.step("正在发送签到请求...")
        response = requests.post(
            url=CHECKIN_URL,
            headers=headers,
            json=data,
            timeout=15,
            verify=False
        )
        response.encoding = "utf-8"
        result = response.json()


        if response.status_code == 200 and result.get("msg") == "成功":
            log.success("签到成功！")
        elif "已签到" in result.get("msg", ""):
            log.success("今日已签到！")
        else:
            log.warning(f"签到结果：{result.get('msg', '未知')}")

    except requests.exceptions.Timeout:
        log.error("签到请求超时！")
    except requests.exceptions.ConnectionError:
        log.error("网络连接失败！")
    except json.JSONDecodeError:
        log.error(f"响应格式异常：{response.text[:100]}")
    except Exception as e:
        log.error(f"签到异常：{str(e)[:100]}")

# ========== 单轮完整广告流程（start→播放→end→时长上报） ==========
def watch_single_ad(ad_index):
    if not OOTOKEN:
        return False, "未配置OOTOKEN"

    headers = get_mobile_headers()
    data = {"access_token": OOTOKEN}  # 接口仅需access_token（和你抓的一致）
    step_success = True

    # 步骤1：调用advertis_start（广告开始，扣减次数）
    try:
        log.step(f"触发第 {ad_index} 个广告开始（扣减次数）...")
        log.info(f"模拟人工操作延时（2-4秒）...")
        random_sleep(2, 4)  # 模拟点击“看广告”的人工延时
        start_res = requests.post(
            url=AD_START_URL,
            headers=headers,
            json=data,
            timeout=15,
            verify=False
        )
        start_result = start_res.json()
        if start_res.status_code != 200 or start_result.get("msg") != "成功":
            error_msg = start_result.get('msg', '未知')
            log.error(f"第 {ad_index} 个广告开始失败：{error_msg}")
            # 检查是否达到次数上限，如果是则终止整个脚本
            if "您今天看广告次数已达上限" in error_msg:
                log.error("检测到广告次数已达上限，终止脚本执行！")
                return False, "次数已达上限"
            step_success = False
        else:
            log.success(f"第 {ad_index} 个广告开始成功！")
    except Exception as e:
        log.error(f"第 {ad_index} 个广告开始异常：{str(e)[:100]}")
        step_success = False

    if not step_success:
        return False, "广告开始失败"

    # 步骤2：模拟广告播放（35秒，适配你30秒的广告）
    log.step(f"正在播放第 {ad_index} 个广告...（{AD_PLAY_DURATION}秒）")
    # 显示倒计时
    for remaining in range(AD_PLAY_DURATION, 0, -5):
        if remaining >= 5:
            log.info(f"广告播放中，剩余 {remaining} 秒...")
            time.sleep(5)
        else:
            time.sleep(remaining)
    log.success(f"第 {ad_index} 个广告播放完成！")

    # 步骤3：调用advertis_end（广告结束，累计时长）
    try:
        log.step(f"触发第 {ad_index} 个广告结束（累计时长）...")
        log.info("请求前随机延时（1-3秒）...")
        random_sleep(1, 3)
        log.step("正在发送广告结束请求...")
        end_res = requests.post(
            url=AD_END_URL,
            headers=headers,
            json=data,
            timeout=15,
            verify=False
        )
        end_result = end_res.json()
        if end_res.status_code != 200 or end_result.get("msg") != "成功":
            error_msg = end_result.get('msg', '未知')
            log.error(f"第 {ad_index} 个广告结束失败：{error_msg}")
            # 检查是否达到次数上限，如果是则终止整个脚本
            if "您今天看广告次数已达上限" in error_msg:
                log.error("检测到广告次数已达上限，终止脚本执行！")
                return False, "次数已达上限"
            step_success = False
        else:
            log.success(f"第 {ad_index} 个广告结束成功！")
    except Exception as e:
        log.error(f"第 {ad_index} 个广告结束异常：{str(e)[:100]}")
        step_success = False

    if not step_success:
        # 如果是次数上限错误，已经返回了，所以这里只处理普通错误
        return False, "广告结束失败"

    # 步骤4：兜底调用duration_log（时长上报，确保统计）
    try:
        log.step(f"上报第 {ad_index} 个广告时长（兜底）...")
