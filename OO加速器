# ========== 日志美化模块 ==========
class SimpleLogger:
    """简约日志输出类"""
    # ANSI颜色代码（仅基础颜色）
    RESET = '\033[0m'
    RED = '\033[31m'
    GREEN = '\033[32m'
    YELLOW = '\033[33m'
    BLUE = '\033[34m'
    CYAN = '\033[36m'
    GRAY = '\033[90m'
    
    @staticmethod
    def get_timestamp():
        """获取格式化的时间戳"""
        return datetime.now().strftime('%Y-%m-%d %H:%M:%S')
    
    @staticmethod
    def _print(level, color, msg):
        """统一打印方法"""
        print(f"{SimpleLogger.GRAY}[{SimpleLogger.get_timestamp()}]{SimpleLogger.RESET} {color}[{level}]{SimpleLogger.RESET} {msg}")
    
    @staticmethod
    def info(msg):
        """信息日志"""
        SimpleLogger._print("INFO", SimpleLogger.CYAN, msg)
    
    @staticmethod
    def success(msg):
        """成功日志"""
        SimpleLogger._print("SUCCESS", SimpleLogger.GREEN, msg)
    
    @staticmethod
    def warning(msg):
        """警告日志"""
        SimpleLogger._print("WARNING", SimpleLogger.YELLOW, msg)
    
    @staticmethod
    def error(msg):
        """错误日志"""
        SimpleLogger._print("ERROR", SimpleLogger.RED, msg)
    
    @staticmethod
    def step(msg):
        """步骤日志"""
        SimpleLogger._print("STEP", SimpleLogger.BLUE, msg)
    
    @staticmethod
    def title(msg):
        """标题日志"""
        print(f"\n{SimpleLogger.CYAN}{'='*50}")
        print(f"{msg}")
        print(f"{'='*50}{SimpleLogger.RESET}\n")
    
    @staticmethod
    def separator():
        """分隔线"""
        print(f"{SimpleLogger.GRAY}{'-'*50}{SimpleLogger.RESET}")
    
    @staticmethod
    def box(title, content_dict):
        """信息框"""
        print(f"\n{SimpleLogger.CYAN}{'-'*50}")
        print(f"{title}")
        print(f"{'-'*50}")
        for key, value in content_dict.items():
            print(f"{key}: {value}")
        print(f"{'-'*50}\n")
    
    @staticmethod
    def progress(current, total, prefix="进度"):
        """进度显示"""
        percent = (current / total) * 100
        bar_length = 20
        filled = int(bar_length * current / total)
        bar = '=' * filled + '-' * (bar_length - filled)
        SimpleLogger.info(f"{prefix}: [{bar}] {current}/{total} ({percent:.1f}%)")

