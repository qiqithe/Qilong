        random_sleep(1, 2)
        log.step("正在发送时长上报请求...")
        duration_res = requests.post(
            url=AD_DURATION_URL,
            headers=headers,
            json=data,
            timeout=15,
            verify=False
        )
        duration_result = duration_res.json()
        # 打印完整响应，方便核对时长累计
